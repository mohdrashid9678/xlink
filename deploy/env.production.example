# xlink Production Environment Configuration

# Server
PORT=8080
GIN_MODE=release

# Database (Replace <DB_PRIVATE_IP> and password, or use AWS RDS endpoint)
DB_URL=postgresql://postgres:ChangeThisStrongPassword123!@<DB_PRIVATE_IP>:5432/xlink?sslmode=disable
AUTO_MIGRATE=true

# Redis Cache (Replace <REDIS_PRIVATE_IP>, or use AWS ElastiCache endpoint)
REDIS_URL=redis://<REDIS_PRIVATE_IP>:6379/0

# Security (Must be at least 32 characters long)
AUTH_JWT_SECRET=replace-with-a-very-secure-random-32-byte-secret-key-here

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# OpenTelemetry Distributed Tracing
OTEL_SERVICE_NAME=xlink-api
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_SAMPLING_RATIO=1.0

# Runtime Profiling (pprof)
PPROF_ENABLED=false
